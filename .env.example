# ── Окружение ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ── База данных ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/yappibot

# ── Публичный адрес приложения (поддомен существующего домена), без слэша в конце
# Пример: https://app.yourdomain.com
APP_URL=

# ── Telegram ─────────────────────────────────────────────────────────────────
# Токен нового бота от @BotFather. Никогда не коммитьте его.
BOT_TOKEN=
# Имя бота без @ (нужно для ссылок и входа в админку из браузера)
BOT_USERNAME=
# webhook — production, polling — локальная разработка, off — бот не принимает /start
TELEGRAM_UPDATES_MODE=off
# Произвольная строка 32+ символов: Telegram присылает её в заголовке webhook-запроса
TELEGRAM_WEBHOOK_SECRET=
# ID рабочего чата для уведомлений команде (необязательно; можно задать в админке)
TEAM_CHAT_ID=
# Сколько секунд считаются действительными данные запуска Mini App
INIT_DATA_MAX_AGE_SECONDS=86400

# ── Сессии админ-панели в браузере ───────────────────────────────────────────
# Случайная строка 32+ символов: openssl rand -hex 32
SESSION_SECRET=

# ── Прочее ───────────────────────────────────────────────────────────────────
DEFAULT_CURRENCY=USD
